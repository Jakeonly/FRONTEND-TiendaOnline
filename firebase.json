{
  "hosting": {
    "public": "web/dist/web/browser",
    "predeploy": [
      "npm --prefix web run build -- --configuration production"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
